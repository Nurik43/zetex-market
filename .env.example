# Скопируйте в .env и заполните:  cp .env.example .env
# Для docker compose файл подключается через env_file. Значения PORT, NODE_ENV, TRUST_PROXY,
# COOKIE_SECURE, APP_URL и CORS_ORIGIN в compose задаются сами (из DOMAIN).

# --- Домен (используется docker-compose и Caddy) ---
# Домен без https://, например shop.example.uz
DOMAIN=localhost

# --- Основное ---
# Секрет подписи JWT-сессий. Если не задан, сервер сам создаст data/.jwt_secret.
# Сгенерировать: openssl rand -hex 48
JWT_SECRET=
# Срок жизни сессии (по умолчанию 7d)
JWT_EXPIRES_IN=7d
# Порт сервера (по умолчанию 3001; в docker-compose уже 3001)
PORT=3001
# Публичный адрес сайта: ссылки в письмах и возвраты после оплаты (без / в конце)
APP_URL=http://localhost:3001
# Разрешённые origin для CORS через запятую (нужно только если фронт на другом домене)
CORS_ORIGIN=
# 1 — сайт за прокси (Caddy/nginx); в production включено и так
TRUST_PROXY=1
# 1/0 — флаг Secure у cookie; по умолчанию включён в production. Ставьте 0 только при HTTP без TLS
COOKIE_SECURE=1
# Часовой пояс для отчётов, сдвиг от UTC в часах (Ташкент = 5)
TZ_OFFSET_HOURS=5

# --- Администратор (создаётся при старте, если задано) ---
# В production без этих переменных администратора не будет
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Пути (обычно менять не нужно) ---
# DATA_DIR=/app/server/data
# DB_FILE=/app/server/data/zetex.db
# UPLOAD_DIR=/app/server/data/uploads
# DIST_DIR=/app/dist

# --- Почта ---
# SMTP-адрес, например smtps://user:pass@smtp.example.com:465. Без него письма не отправляются
SMTP_URL=
MAIL_FROM=Zetex Market <no-reply@zetex.uz>
# 1 — требовать подтверждённую почту для оформления заказов
REQUIRE_VERIFIED_EMAIL=0

# --- Telegram-бот (уведомления) ---
# Без токена бот не запускается
TELEGRAM_BOT_TOKEN=
# Чат администратора для уведомлений о модерации
TELEGRAM_ADMIN_CHAT_ID=

# --- Оплата ---
# 1 — демо-оплата без реального провайдера. По умолчанию выключена в production.
# На боевом сервере с реальными платежами должна быть 0!
PAYMENTS_MOCK=0
# Сколько минут ждём оплату онлайн-заказа до автоотмены
PAYMENT_HOLD_MINUTES=30
# Payme (https://developer.help.paycom.uz). PAYME_TEST=1 — тестовый шлюз
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=0
# Click (https://docs.click.uz)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Доставка (сумы) ---
# Стоимость доставки курьером
DELIVERY_FEE=25000
# Бесплатная доставка от суммы товаров
FREE_DELIVERY_FROM=500000

# --- Реквизиты и контакты (страницы «Контакты», условия, подвал). Пустое не показывается ---
COMPANY_NAME=ООО «ZETEX MARKET»
COMPANY_INN=
COMPANY_ADDRESS=
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_HOURS=
# Ссылки на соцсети (необязательно), например https://t.me/zetex_support
SUPPORT_TELEGRAM=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=

# --- Пункты выдачи (JSON-массив; город должен быть из списка городов доставки) ---
# PICKUP_POINTS=[{"id":"tash-1","city":"Ташкент","name":"Пункт выдачи на Амира Темура","address":"г. Ташкент, ул. Амира Темура, 1"}]

# --- Демо-данные ---
# В production демо-аккаунты (info@zetex.uz, seller@zetex.uz с публичными паролями) и 100 демо-товаров НЕ создаются.
# Для пробного стенда можно включить: SEED_DEMO=1. На боевом сайте не включайте.
# SEED_DEMO=0
